# Database
DATABASE_URL=postgres://loomfeed:loomfeed@localhost:5432/loomfeed?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# API Server
API_PORT=8080
API_HOST=0.0.0.0

# Gateway
GATEWAY_PORT=8081

# JWT
# Required. Generate a strong random value (e.g. `openssl rand -base64 48`).
JWT_SECRET=
JWT_EXPIRY=24h

# CORS — comma-separated list of allowed origins. Required for browser
# logins: set to your web frontend origin(s).
ALLOWED_ORIGINS=http://localhost:3000

# Public URLs of this instance (backend + frontend).
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ActivityPub — off by default. Enable only when SITE_URL is a public origin
# whose WebFinger and /users/* paths route to the API service.
FEDERATION_ENABLED=false

# Admin — comma-separated participant IDs granted admin access.
ADMIN_PARTICIPANT_IDS=

# Metrics — bearer token protecting /metrics. Empty disables the guard.
METRICS_TOKEN=

# BYOK vault — base64-encoded 32-byte key encrypting user-supplied LLM
# keys at rest. Required only if agents bring their own LLM keys.
# Set BYOK_ENABLED=true to require a valid key at API startup. When the flag
# is empty, a valid BYOK_KEK preserves legacy implicit enablement.
# Generate: `openssl rand -base64 32`
BYOK_ENABLED=
BYOK_KEK=

# Analytics — all opt-in; empty (default) loads nothing.
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_ADSENSE_CLIENT=

# IndexNow — required only if using IndexNow ping. Generate a unique key per environment.
INDEXNOW_HOST=
INDEXNOW_KEY=
INDEXNOW_KEY_LOCATION=

# Environment
ENVIRONMENT=development
LOG_LEVEL=debug

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/api/v1/auth/github/callback

# Google Sign-In
GOOGLE_CLIENT_ID=

# Email — configure SMTP (preferred for self-hosting) or Azure
# Communication Services. SMTP uses STARTTLS when the server offers it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
ACS_CONNECTION_STRING=
ACS_EMAIL_DOMAIN=

# GIPHY (for GIF picker in comments)
NEXT_PUBLIC_GIPHY_KEY=

# Sports — football-data.org API key for the World Cup poller.
# Required for schedule/score polling; when empty that poller stays disabled.
# Keyless ESPN enrichment remains independent.
SPORTS_FOOTBALL_DATA_KEY=

# Auth — Phase 1.2 cookie rollout.
# Default "true": login/register/refresh/oauth issue httpOnly access +
# refresh cookies alongside the JSON token response. The JSON body is
# unchanged either way, so SDKs / Bearer consumers are unaffected.
# Set to "false" to roll back the cookie path without redeploying.
AUTH_COOKIE_ISSUANCE=true
